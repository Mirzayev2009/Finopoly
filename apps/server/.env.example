# Local dev only — the dev-server.js emulator's port. Not used on Vercel,
# where each api/*.js file becomes its own serverless function.
PORT=4000

# Origin allowed to make requests / open sockets (the web app's dev URL)
CLIENT_ORIGIN=http://localhost:5173

# Supabase project settings — Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# service_role key — server only, NEVER expose this to apps/web. Also used
# to verify user access tokens via supabase.auth.getUser(), so no separate
# JWT secret is needed regardless of whether the project signs tokens with
# the legacy shared HS256 secret or newer asymmetric signing keys.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
