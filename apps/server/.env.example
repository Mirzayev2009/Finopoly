# Local dev only — the dev-server.js emulator's port. Not used on Vercel,
# where each api/*.js file becomes its own serverless function.
PORT=4000

# Origin allowed to make requests / open sockets (the web app's dev URL)
CLIENT_ORIGIN=http://localhost:5173

# Supabase project settings — Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# service_role key — server only, NEVER expose this to apps/web
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Project Settings > API > JWT Settings > JWT Secret (used to verify
# access tokens issued by Supabase Auth, HS256)
SUPABASE_JWT_SECRET=your-jwt-secret
